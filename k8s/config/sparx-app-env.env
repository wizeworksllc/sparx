# sparx-app-env: every plain (non-secret) value a sparx app pod reads.
#
# ── WHY THIS IS THE WHOLE CONFIGURATION ────────────────────────────────────
#
# Until docs/153 Phase 5 the three apps (web, market, workbench) ran in
# `sparx-prod` and read the platform's `sparx-app-env`, which also carries
# everything api-rest and the workers need. A ConfigMap is read only from its
# own namespace, so in `sparx` there is nothing to inherit: a key an app reads
# that is missing here is simply unset. Several platform packages fall back
# quietly when that happens (an origin lookup throws only at the first request,
# a brand value falls back to the default brand), so every key below was found
# by reading the apps AND every @wizeworksllc/* package they install, and each
# group says who reads it.
#
# What is NOT here, on purpose: the broker, the socket bus, Typesense, Mailgun,
# the auth URLs, the social switches and the database. None of the three apps
# reads them; they are api-rest's and the workers'. The workbench holds no
# database connection and no auth instance (docs/154); its /api/auth proxy and
# /api/token BFF forward to api-rest at SPARX_API_REST_URL.
#
# Secrets are NOT here either. The release writes `sparx-app-secrets` from Key
# Vault (NEXT_ACTIONS_KEY_* and WIZELENS_KEY_*), and each Deployment reads its
# two keys by name.

# ── Which brand these pods are ────────────────────────────────────────────────
#
# Read by @wizeworksllc/brand-core's `currentPlatformBrand()`. In sparx-prod it
# was set on each Deployment, because sparx-app-env is also read by api-rest and
# api-mcp, which serve both brands from one process. Every pod in THIS namespace
# is sparx, so it is set once here.
PLATFORM_BRAND=sparx

# ── Where the API is ──────────────────────────────────────────────────────────
#
# SPARX_API_REST_URL is the in-cluster address the servers call (web, market and
# the workbench's /api/token BFF). It names the Service in sparx-prod with its
# full name, because a short name resolves only inside its own namespace. The
# NEXT_PUBLIC_ / PUBLIC_ values are what a browser calls.
SPARX_API_REST_URL=http://api-rest.sparx-prod.svc.cluster.local:3000
SPARX_PUBLIC_API_REST_URL=https://api.sparx.works
NEXT_PUBLIC_API_URL=https://api.sparx.works

# ── Where each console is ─────────────────────────────────────────────────────
#
# Read by @wizeworksllc/links (`appOrigin`, `mcpUrl`, the account origin) for the
# links the workbench prints, and by the marketing site's sign-up buttons. The
# variable names are derived from the brand key (`<BRAND>_APP_URL`), so links
# reads the Piggles values too when a page names that brand.
SPARX_APP_URL=https://app.sparx.works
NEXT_PUBLIC_APP_URL=https://app.sparx.works
SPARX_DASHBOARD_URL=https://app.sparx.works
SPARX_MCP_URL=https://mcp.sparx.works/mcp
PIGGLES_APP_URL=https://mypiggles.com
PIGGLES_ACCOUNT_URL=https://getpiggles.com
PIGGLES_MCP_URL=https://mcp.mypiggles.com/mcp

# ── Brand values ──────────────────────────────────────────────────────────────
#
# Read by @wizeworksllc/brand-core as `<BRAND>_<SUFFIX>`. COPIES of the values in
# the platform's sparx-app-env (k8s/azure/infra/app-env-configmap.env in
# wizeworksllc/platform), which api-rest and the event workers read when they
# mail a tenant. A change to a brand value is a change in BOTH places. The
# Piggles wordmark there is generated from the brand registry and checked by
# the platform's check:brand-wordmark; this copy is not checked, so copy it
# again whenever that one changes.
SPARX_BRAND_NAME=sparx
SPARX_BRAND_URL=https://sparx.works
SPARX_BRAND_ACCENT=#e04631
SPARX_BRAND_ACCENT_CHARS=1
SPARX_ZONE_DOMAIN=sparx.zone
SPARX_CREDIT_URL=https://sparx.works/?utm_source=powered_by&utm_medium=site_badge&utm_campaign=made_with_sparx

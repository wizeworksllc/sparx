auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
prefer-workspace-packages=true
link-workspace-packages=true

# The platform packages (@wizeworksllc/*) publish to GitHub Packages from
# wizeworksllc/platform. Reading them needs a token with `read:packages`:
#   locally   export GITHUB_PACKAGES_TOKEN=$(gh auth token)
#   in CI     the workflow sets it from GITHUB_TOKEN
#   Docker    a build secret, never a build argument (it would land in a layer)
@wizeworksllc:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_PACKAGES_TOKEN}

# Font Awesome Pro.
@fortawesome:registry=https://npm.fontawesome.com/
//npm.fontawesome.com/:_authToken=${FONTAWESOME_NPM_TOKEN}

# Turbopack resolves CSS `@plugin "@wizeworks/silicaui"` from the workspace root,
# not from the app's own node_modules, so the silicaui family is hoisted there.
public-hoist-pattern[]=silicaui*
